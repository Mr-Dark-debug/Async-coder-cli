{
  "name": "async-coder",
  "displayName": "async-coder",
  "description": "async-coder agent sidebar, code actions and terminal for VS Code",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-Dark-debug/Async-coder-cli"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#b4a4ef",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "capabilities": { "untrustedWorkspaces": { "supported": false, "description": "async-coder can edit files and run commands." }, "virtualWorkspaces": false },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "async-coder", "title": "async-coder", "icon": "images/button-dark.svg" }]
    },
    "views": {
      "async-coder": [{ "type": "webview", "id": "async-coder.agent", "name": "Agent" }]
    },
    "configuration": {
      "title": "async-coder",
      "properties": {
        "async-coder.executable": { "type": "string", "default": "async-coder", "description": "Path to the async-coder CLI executable. Requires a trusted local workspace.", "scope": "machine" }
      }
    },
    "commands": [
      { "command": "async-coder.openPanel", "title": "async-coder: Open Agent Panel" },
      { "command": "async-coder.explainSelection", "title": "async-coder: Explain Selection" },
      { "command": "async-coder.generateTests", "title": "async-coder: Generate Tests" },
      { "command": "async-coder.reviewFile", "title": "async-coder: Review File" },
      { "command": "async-coder.fixIssue", "title": "async-coder: Fix Issue at Cursor" },
      {
        "command": "opencode.openTerminal",
        "title": "Open async-coder Terminal",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Open async-coder in New Terminal",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "async-coder.explainSelection", "when": "editorHasSelection", "group": "async-coder" },
        { "command": "async-coder.generateTests", "group": "async-coder" },
        { "command": "async-coder.reviewFile", "group": "async-coder" },
        { "command": "async-coder.fixIssue", "group": "async-coder" }
      ],
      "editor/title": [
        {
          "command": "opencode.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      { "command": "async-coder.openPanel", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "async-coder.explainSelection", "key": "ctrl+alt+e", "mac": "cmd+alt+e", "when": "editorHasSelection" },
      { "command": "async-coder.fixIssue", "key": "ctrl+alt+i", "mac": "cmd+alt+i", "when": "editorTextFocus" },
      {
        "command": "opencode.openTerminal",
        "title": "Run opencode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Run opencode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "opencode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "typecheck": "tsgo --noEmit",
    "check-types": "bun typecheck",
    "lint": "eslint src",
    "test": "bun test test",
    "test:host": "vscode-test"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "@types/bun": "1.3.11",
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
